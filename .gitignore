!docs/**/*.jpg

# Model weights (large binary files, never committed)
models/*
!models/README.md

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
